LOAD DATABASE
     FROM mysql://root:12345@localhost/dacky
     INTO postgresql://postgres:12345@localhost/dacky

 WITH include drop, create tables, create indexes, reset sequences

 SET maintenance_work_mem to '128MB',
     work_mem to '12MB',
     search_path to 'public'

 CAST type bigint when (= precision 12) to bigint drop typemod,
      type int(11) to integer,
      type int(2) to integer,
      type decimal to numeric,
      type text to text,
      type enum to varchar(20),
      type datetime to timestamp;

